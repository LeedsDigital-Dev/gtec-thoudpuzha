# File Storage (s03-t1 - Gallery, s06-t2 - Academic resources)
# e.g. AWS S3, Cloudflare R2, or similar
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=

# Next.js
NEXT_PUBLIC_SUPPORTED_LOCALES=en,ml
