generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  JOB_SEEKER
  EMPLOYER
  CENTRE_STAFF
  SUPER_ADMIN
}

model User {
  id                String   @id
  role              Role
  languagePreference String   @default("en")
  createdAt         DateTime @default(now())

  candidateProfile CandidateProfile?
  auditLogEntries  AuditLogEntry[]
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model CourseCategory {
  id        String   @id @default(cuid())
  nameEn    String
  nameMl    String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses   Course[]

  @@index([sortOrder])
}

model Course {
  id              String       @id @default(cuid())
  slug            String       @unique
  titleEn         String
  titleMl         String?
  categoryId      String?
  descriptionEn   String?
  descriptionMl   String?
  durationText    String?
  syllabus        Json?
  certifications  String[]
  careerOutcomesEn String?
  careerOutcomesMl String?
  coverImageUrl   String?
  featured        Boolean      @default(false)
  status          CourseStatus @default(DRAFT)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  category        CourseCategory? @relation(fields: [categoryId], references: [id])
  enquiries       Enquiry[]

  @@index([categoryId])
  @@index([status])
  @@index([featured])
}

model CandidateProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  isVerifiedStudent Boolean  @default(false)
  studentRecordId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model FlashNewsItem {
  id        String   @id @default(cuid())
  textEn    String
  textMl    String?
  link      String?
  active    Boolean  @default(true)
  expiresAt DateTime?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, expiresAt])
  @@index([sortOrder])
}

model Enquiry {
  id        String   @id @default(cuid())
  name      String
  phone     String
  courseId  String?
  message   String?
  source    String
  createdAt DateTime @default(now())

  course Course? @relation(fields: [courseId], references: [id])

  @@index([courseId])
  @@index([createdAt])
}

enum WhyCardIcon {
  AWARD
  USERS
  BOOK_OPEN
  BRIEFCASE
  GLOBE
  HEADPHONES
}

model SiteSettings {
  id                   String   @id @default(cuid())
  yearsInOperation     String   @default("25+")
  studentsTrained     String   @default("3.2M+")
  centresWorldwide     String   @default("800+")
  affiliations         String   @default("100+")
  countries            String   @default("23")
  aboutBodyEn          String   @default("")
  aboutBodyMl          String?
  aboutPhotoUrl        String?
  address              String?
  mapEmbedUrl          String?
  facebookUrl          String?
  instagramUrl         String?
  youtubeUrl           String?
  linkedinUrl          String?
  googleReviewsUrl     String?
  whyChooseUsCards     WhyChooseUsCard[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

enum NewsEventType {
  NEWS
  EVENT
}

model NewsEvent {
  id            String         @id @default(cuid())
  type          NewsEventType
  titleEn       String
  titleMl       String?
  bodyEn        String
  bodyMl        String?
  coverImageUrl String?
  eventDate     DateTime?
  publishedAt   DateTime?
  slug          String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([type])
  @@index([publishedAt])
  @@index([eventDate])
}

enum GalleryMediaType {
  IMAGE
  VIDEO
}

model GalleryCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameEn    String
  nameMl    String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items GalleryItem[]

  @@index([sortOrder])
}

model GalleryItem {
  id        String           @id @default(cuid())
  categoryId String
  mediaType   GalleryMediaType
  url         String
  captionEn   String?
  captionMl   String?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())

  category GalleryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([sortOrder])
}

model CertificationPartner {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String
  link      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sortOrder])
}

model WhyChooseUsCard {
  id             String       @id @default(cuid())
  siteSettingsId String
  sortOrder      Int          @default(0)
  icon           WhyCardIcon
  titleEn        String
  titleMl        String?
  descriptionEn  String
  descriptionMl  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  siteSettings SiteSettings @relation(fields: [siteSettingsId], references: [id], onDelete: Cascade)

  @@index([siteSettingsId])
  @@index([sortOrder])
}

model AuditLogEntry {
  id           String   @id @default(cuid())
  actorUserId  String
  actorRole    Role
  action       String
  entityType   String
  entityId     String
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  actor User @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

